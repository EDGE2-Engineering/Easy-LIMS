# =====================================================================
# AWS DynamoDB Configuration
# =====================================================================
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=easy_lims

# AWS Credentials (leave blank if running with an IAM role or AWS CLI profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Local DynamoDB / LocalStack endpoint (e.g., http://localhost:8000)
# Leave blank or omit for AWS Cloud DynamoDB
DYNAMODB_ENDPOINT_URL=

# =====================================================================
# Application Settings
# =====================================================================
API_TOKEN_EXPIRY_HOURS=24
PORT=8000

# =====================================================================
# Migration Settings (PostgreSQL -> DynamoDB)
# =====================================================================
# Set to 'true' to wipe all existing DynamoDB items before starting data migration
DYNAMODB_CLEAR_BEFORE_MIGRATION=false
