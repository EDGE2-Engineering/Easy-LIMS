# =====================================================================
# Easy-LIMS Environment Configuration
# =====================================================================
# Copy this file to .env and update the values:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Option 1: Database Connection URL (Recommended)
# ---------------------------------------------------------------------
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easy_lims

# Cloud PostgreSQL example (e.g. Supabase, Neon, AWS RDS with SSL):
# DATABASE_URL=postgresql://postgres:your_password@db.yourproject.supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------
# Option 2: Individual Database Connection Parameters
# (Used if DATABASE_URL is not provided)
# ---------------------------------------------------------------------
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=easy_lims

# Alternatively, POSTGRES_* environment variable aliases are also supported:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_DB=easy_lims

# ---------------------------------------------------------------------
# Database Connection Pool Settings (Optional)
# ---------------------------------------------------------------------
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# ---------------------------------------------------------------------
# Application & Authentication Settings (Optional)
# ---------------------------------------------------------------------
API_TOKEN_EXPIRY_HOURS=24
PORT=8000
